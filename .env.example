# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_erp?schema=public"

# JWT - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET="CHANGE_ME_32_CHARS_MINIMUM_ACCESS"
JWT_REFRESH_SECRET="CHANGE_ME_32_CHARS_MINIMUM_REFRESH"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV="development"

# Multi-tenant
TENANT_MODE="single"  # single | multi

# Security
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Redis (optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@pharmacy-erp.com"

# Frontend
VITE_API_URL="http://localhost:3001/api/v1"
