{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@packages/database": ["../../packages/database/src"],
      "@packages/database/*": ["../../packages/database/src/*"],
      "@packages/shared": ["../../packages/shared/src"],
      "@packages/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}