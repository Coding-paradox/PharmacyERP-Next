generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  pharmacy_id       String          @db.Uuid
  role_id           String          @db.Uuid
  firstName         String          @map("first_name") @db.VarChar(100)
  lastName          String          @map("last_name") @db.VarChar(100)
  username          String          @unique(map: "users_username_unique") @db.VarChar(100)
  email             String          @unique(map: "users_email_unique") @db.VarChar(255)
  phone             String?         @db.VarChar(30)
  password          String          @db.VarChar(255)
  photo             String?         @db.VarChar(255)
  email_verified_at DateTime?       @db.Timestamp(0)
  lastLoginAt       DateTime?       @map("last_login_at") @db.Timestamp(0)
  is_active         Boolean         @default(true)
  remember_token    String?         @db.VarChar(100)
  createdAt         DateTime?       @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?       @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  employee          Employee[]
  purchases         purchases[]
  sales             Sale[]
  stockMovements    StockMovement[]
  pharmacies        pharmacies      @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_pharmacy_id_foreign")
  roles             Role            @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_role_id_foreign")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique(map: "roles_name_unique") @db.VarChar(100)
  display_name    String           @db.VarChar(150)
  description     String?
  is_active       Boolean          @default(true)
  createdAt       DateTime?        @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  deleted_at      DateTime?        @db.Timestamp(0)
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique(map: "permissions_name_unique") @db.VarChar(100)
  display_name    String           @db.VarChar(150)
  description     String?
  is_active       Boolean          @default(true)
  createdAt       DateTime?        @map("created_at") @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  deleted_at      DateTime?        @db.Timestamp(0)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_id_foreign")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_foreign")

  @@unique([roleId, permissionId], map: "role_permissions_role_id_permission_id_unique")
  @@map("role_permissions")
}

model Employee {
  id              String     @id @default(uuid()) @db.Uuid
  pharmacy_id     String     @db.Uuid
  userId          String?    @map("user_id") @db.Uuid
  employee_number String     @unique(map: "employees_employee_number_unique") @db.VarChar(30)
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  gender          String     @db.VarChar(255)
  birth_date      DateTime?  @db.Date
  phone           String?    @db.VarChar(30)
  email           String?    @db.VarChar(255)
  address         String?    @db.VarChar(255)
  position        String     @db.VarChar(100)
  hireDate        DateTime   @map("hire_date") @db.Date
  salary          Decimal?   @db.Decimal(12, 2)
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?  @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  pharmacies      pharmacies @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employees_pharmacy_id_foreign")
  user            User?      @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "employees_user_id_foreign")

  @@map("employees")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  pharmacy_id String     @db.Uuid
  name        String     @unique(map: "categories_name_unique") @db.VarChar(100)
  description String?
  is_active   Boolean    @default(true)
  createdAt   DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?  @updatedAt @map("updated_at")
  deleted_at  DateTime?  @db.Timestamp(0)
  pharmacies  pharmacies @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_pharmacy_id_foreign")
  medicines   Medicine[]

  @@map("categories")
}

model Manufacturer {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique(map: "manufacturers_name_unique") @db.VarChar(150)
  country    String?    @db.VarChar(100)
  city       String?    @db.VarChar(100)
  phone      String?    @db.VarChar(30)
  email      String?    @db.VarChar(255)
  website    String?    @db.VarChar(255)
  address    String?
  is_active  Boolean    @default(true)
  createdAt  DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime?  @updatedAt @map("updated_at")
  deleted_at DateTime?  @db.Timestamp(0)
  medicines  Medicine[]

  @@map("manufacturers")
}

model Medicine {
  id                  String                @id @default(uuid()) @db.Uuid
  pharmacy_id         String                @db.Uuid
  categoryId          String                @map("category_id") @db.Uuid
  manufacturerId      String?               @map("manufacturer_id") @db.Uuid
  code                String                @unique(map: "medicines_code_unique") @db.VarChar(50)
  barcode             String?               @unique(map: "medicines_barcode_unique") @db.VarChar(255)
  name                String                @db.VarChar(200)
  genericName         String?               @map("generic_name") @db.VarChar(200)
  dosage              String?               @db.VarChar(100)
  country             String?               @db.VarChar(100)
  description         String?
  requiresPrescription Boolean               @default(false) @map("requires_prescription")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime?             @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?             @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  medicine_batches    medicine_batches[]
  medicine_packagings medicine_packagings[]
  medicine_prices     medicine_prices[]
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicines_category_id_foreign")
  manufacturer        Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "medicines_manufacturer_id_foreign")
  pharmacies          pharmacies            @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicines_pharmacy_id_foreign")
  purchase_items      purchase_items[]
  saleItems           SaleItem[]

  @@map("medicines")
}

model Stock {
  id                  String              @id @default(uuid()) @db.Uuid
  pharmacy_id         String              @db.Uuid
  batchId             String              @map("batch_id") @db.Uuid
  packaging_id        String              @db.Uuid
  quantity            Int                 @default(0)
  minimum_quantity    Int                 @default(0)
  maximum_quantity    Int?
  location            String?             @db.VarChar(100)
  is_active           Boolean             @default(true)
  created_at          DateTime?           @db.Timestamp(0)
  updatedAt           DateTime?           @updatedAt @map("updated_at")
  deleted_at          DateTime?           @db.Timestamp(0)
  stock_movements     StockMovement[]
  batch               medicine_batches    @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stocks_batch_id_foreign")
  medicine_packagings medicine_packagings @relation(fields: [packaging_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stocks_packaging_id_foreign")
  pharmacies          pharmacies          @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stocks_pharmacy_id_foreign")

  @@map("stocks")
}

model StockMovement {
  id              String     @id @default(uuid()) @db.Uuid
  pharmacy_id     String     @db.Uuid
  stock_id        String     @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  movement_type   String     @db.VarChar(255)
  quantity        Int
  quantity_before Int
  quantity_after  Int
  reference       String?    @db.VarChar(100)
  remarks         String?
  createdAt       DateTime?  @map("created_at") @db.Timestamp(0)
  updated_at      DateTime?  @db.Timestamp(0)
  pharmacies      pharmacies @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_movements_pharmacy_id_foreign")
  stocks          Stock      @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_movements_stock_id_foreign")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_movements_user_id_foreign")

  @@map("stock_movements")
}

model Supplier {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique(map: "suppliers_code_unique") @db.VarChar(30)
  company_name    String      @db.VarChar(200)
  contact_person  String?     @db.VarChar(150)
  phone           String      @db.VarChar(30)
  alternate_phone String?     @db.VarChar(30)
  email           String?     @db.VarChar(255)
  website         String?     @db.VarChar(255)
  city            String?     @db.VarChar(100)
  country         String?     @db.VarChar(100)
  address         String?
  notes           String?
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime?   @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?   @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")
  purchases       purchases[]

  @@map("suppliers")
}

model Customer {
  id          String     @id @default(uuid()) @db.Uuid
  pharmacy_id String     @db.Uuid
  code        String     @unique(map: "customers_code_unique") @db.VarChar(30)
  full_name   String     @db.VarChar(200)
  gender      String?    @db.VarChar(255)
  birth_date  DateTime?  @db.Date
  phone       String?    @db.VarChar(30)
  email       String?    @db.VarChar(255)
  address     String?
  city        String?    @db.VarChar(100)
  blood_group String?    @db.VarChar(5)
  allergies   String?
  notes       String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?  @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  pharmacies  pharmacies @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customers_pharmacy_id_foreign")
  sales       Sale[]

  @@map("customers")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  pharmacy_id   String     @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  customerId    String?    @map("customer_id") @db.Uuid
  invoiceNumber String     @unique(map: "sales_invoice_number_unique") @map("invoice_number") @db.VarChar(100)
  sale_date     DateTime   @db.Timestamp(0)
  subtotal      Decimal    @default(0) @db.Decimal(14, 2)
  discount      Decimal    @default(0) @db.Decimal(14, 2)
  tax           Decimal    @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal    @map("total_amount") @db.Decimal(14, 2)
  paid_amount   Decimal    @default(0) @db.Decimal(14, 2)
  change_amount Decimal    @default(0) @db.Decimal(14, 2)
  status        String     @default("PAID") @db.VarChar(255)
  notes         String?
  createdAt     DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?  @updatedAt @map("updated_at")
  deleted_at    DateTime?  @db.Timestamp(0)
  items         SaleItem[]
  customer      Customer?  @relation(fields: [customerId], references: [id], onUpdate: NoAction, map: "sales_customer_id_foreign")
  pharmacies    pharmacies @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sales_pharmacy_id_foreign")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sales_user_id_foreign")

  @@map("sales")
}

model SaleItem {
  id                  String              @id @default(uuid()) @db.Uuid
  saleId              String              @map("sale_id") @db.Uuid
  medicineId          String              @map("medicine_id") @db.Uuid
  batchId             String              @map("batch_id") @db.Uuid
  packaging_id        String              @db.Uuid
  quantity            Int
  base_quantity       Int
  unitPrice           Decimal             @map("unit_price") @db.Decimal(14, 2)
  unit_cost           Decimal             @db.Decimal(14, 2)
  discount            Decimal             @default(0) @db.Decimal(14, 2)
  line_total          Decimal             @db.Decimal(14, 2)
  line_profit         Decimal             @db.Decimal(14, 2)
  createdAt           DateTime?           @map("created_at") @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  deleted_at          DateTime?           @db.Timestamp(0)
  batch               medicine_batches    @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_items_batch_id_foreign")
  medicine            Medicine            @relation(fields: [medicineId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_items_medicine_id_foreign")
  medicine_packagings medicine_packagings @relation(fields: [packaging_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_items_packaging_id_foreign")
  sale                Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_items_sale_id_foreign")

  @@map("sale_items")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([connection, queue, failed_at], map: "failed_jobs_connection_queue_failed_at_index")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model medicine_batches {
  id                 String           @id @default(uuid()) @db.Uuid
  medicine_id        String           @db.Uuid
  batch_number       String           @unique(map: "medicine_batches_batch_number_unique") @db.VarChar(100)
  manufacturing_date DateTime?        @db.Date
  expiration_date    DateTime         @db.Date
  initial_quantity   Int
  remaining_quantity Int
  purchase_price     Decimal          @db.Decimal(12, 2)
  selling_price      Decimal          @db.Decimal(12, 2)
  is_active          Boolean          @default(true)
  created_at         DateTime?        @db.Timestamp(0)
  updated_at         DateTime?        @db.Timestamp(0)
  deleted_at         DateTime?        @db.Timestamp(0)
  medicines          Medicine         @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicine_batches_medicine_id_foreign")
  purchase_items     purchase_items[]
  saleItems          SaleItem[]
  stocks             Stock[]
}

model medicine_forms {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique(map: "medicine_forms_name_unique") @db.VarChar(100)
  description String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  deleted_at  DateTime? @db.Timestamp(0)
}

model medicine_packagings {
  id              String            @id @default(uuid()) @db.Uuid
  medicine_id     String            @db.Uuid
  unit_id         String            @db.Uuid
  name            String            @db.VarChar(100)
  quantity        Int
  purchase_price  Decimal           @default(0) @db.Decimal(12, 2)
  selling_price   Decimal           @default(0) @db.Decimal(12, 2)
  is_default      Boolean           @default(false)
  is_active       Boolean           @default(true)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  deleted_at      DateTime?         @db.Timestamp(0)
  medicines       Medicine          @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicine_packagings_medicine_id_foreign")
  medicine_units  medicine_units    @relation(fields: [unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicine_packagings_unit_id_foreign")
  medicine_prices medicine_prices[]
  purchase_items  purchase_items[]
  sale_items      SaleItem[]
  stocks          Stock[]
}

model medicine_prices {
  id                  String              @id @default(uuid()) @db.Uuid
  medicine_id         String              @db.Uuid
  packaging_id        String              @db.Uuid
  type                String              @default("VENTE") @db.VarChar(255)
  price               Decimal             @db.Decimal(14, 2)
  discount_percentage Decimal             @default(0) @db.Decimal(5, 2)
  is_active           Boolean             @default(true)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  deleted_at          DateTime?           @db.Timestamp(0)
  medicines           Medicine            @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicine_prices_medicine_id_foreign")
  medicine_packagings medicine_packagings @relation(fields: [packaging_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicine_prices_packaging_id_foreign")

  @@unique([medicine_id, packaging_id, type], map: "medicine_prices_medicine_id_packaging_id_type_unique")
}

model medicine_units {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String                @unique(map: "medicine_units_name_unique") @db.VarChar(100)
  symbol              String?               @db.VarChar(20)
  description         String?
  is_active           Boolean               @default(true)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  deleted_at          DateTime?             @db.Timestamp(0)
  medicine_packagings medicine_packagings[]
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model pharmacies {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique(map: "pharmacies_code_unique") @db.VarChar(20)
  name            String          @db.VarChar(150)
  owner_name      String?         @db.VarChar(150)
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(30)
  alternate_phone String?         @db.VarChar(30)
  city            String          @db.VarChar(100)
  commune         String?         @db.VarChar(100)
  quartier        String?         @db.VarChar(100)
  avenue          String?         @db.VarChar(150)
  number          String?         @db.VarChar(20)
  address         String?
  logo            String?         @db.VarChar(255)
  is_active       Boolean         @default(true)
  created_at      DateTime?       @db.Timestamp(0)
  updated_at      DateTime?       @db.Timestamp(0)
  deleted_at      DateTime?       @db.Timestamp(0)
  categories      Category[]
  customers       Customer[]
  employees       Employee[]
  medicines       Medicine[]
  purchases       purchases[]
  sales           Sale[]
  stock_movements StockMovement[]
  stocks          Stock[]
  users           User[]
}

model products {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model purchase_items {
  id                  String              @id @default(uuid()) @db.Uuid
  purchase_id         String              @db.Uuid
  medicine_id         String              @db.Uuid
  batch_id            String              @db.Uuid
  packaging_id        String              @db.Uuid
  quantity            Int
  unit_price          Decimal             @db.Decimal(14, 2)
  discount            Decimal             @default(0) @db.Decimal(14, 2)
  line_total          Decimal             @db.Decimal(14, 2)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  deleted_at          DateTime?           @db.Timestamp(0)
  medicine_batches    medicine_batches    @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_items_batch_id_foreign")
  medicines           Medicine            @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_items_medicine_id_foreign")
  medicine_packagings medicine_packagings @relation(fields: [packaging_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_items_packaging_id_foreign")
  purchases           purchases           @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_items_purchase_id_foreign")
}

model purchases {
  id               String           @id @default(uuid()) @db.Uuid
  pharmacy_id      String           @db.Uuid
  supplier_id      String           @db.Uuid
  user_id          String           @db.Uuid
  invoice_number   String           @unique(map: "purchases_invoice_number_unique") @db.VarChar(100)
  purchase_date    DateTime         @db.Date
  subtotal         Decimal          @default(0) @db.Decimal(14, 2)
  discount         Decimal          @default(0) @db.Decimal(14, 2)
  tax              Decimal          @default(0) @db.Decimal(14, 2)
  total_amount     Decimal          @default(0) @db.Decimal(14, 2)
  paid_amount      Decimal          @default(0) @db.Decimal(14, 2)
  remaining_amount Decimal          @default(0) @db.Decimal(14, 2)
  status           String           @default("PENDING") @db.VarChar(255)
  notes            String?
  created_at       DateTime?        @db.Timestamp(0)
  updated_at       DateTime?        @db.Timestamp(0)
  deleted_at       DateTime?        @db.Timestamp(0)
  purchase_items   purchase_items[]
  pharmacies       pharmacies       @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchases_pharmacy_id_foreign")
  suppliers        Supplier         @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchases_supplier_id_foreign")
  users            User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchases_user_id_foreign")
}