{
  "name": "pharmacy-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Pharmacy ERP system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter api start:dev",
    "build": "pnpm --filter api build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "prisma:generate": "pnpm --filter database prisma:generate",
    "prisma:migrate": "pnpm --filter database prisma:migrate",
    "prisma:studio": "pnpm --filter database prisma:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo type-check"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prettier": "^3.3.3",
    "prisma": "^7.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}