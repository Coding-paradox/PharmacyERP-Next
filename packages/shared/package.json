{
  "name": "@pharmacy/shared",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./config/configuration": {
      "types": "./dist/config/configuration.d.ts",
      "import": "./dist/config/configuration.js"
    },
    "./config/validation.schema": {
      "types": "./dist/config/validation.schema.d.ts",
      "import": "./dist/config/validation.schema.js"
    },
    "./dto/*": {
      "types": "./dist/dto/*.d.ts",
      "import": "./dist/dto/*.js"
    },
    "./filters/*": {
      "types": "./dist/filters/*.d.ts",
      "import": "./dist/filters/*.js"
    },
    "./interceptors/*": {
      "types": "./dist/interceptors/*.d.ts",
      "import": "./dist/interceptors/*.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "import": "./dist/repositories/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@pharmacy/database": "workspace:*",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "express": "^4.21.1",
    "joi": "^17.13.3",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0"
  }
}
